# Required: bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Minimum number of different channels the same message must appear in to count as spam (>= 2)
MIN_CHANNELS=3

# All copies must be posted within this many seconds of each other to count together
MAX_DELTA_SECONDS=300

# How long to time out the sender, in minutes (0 disables timeouts)
TIMEOUT_MINUTES=15

# How far back to scan channel history on startup, in hours (0 disables the scan)
SCAN_LOOKBACK_HOURS=24

# Optional: channel ID where the bot reports what it deleted
LOG_CHANNEL_ID=
